{
	"$schema": "vscode://schemas/color-theme",
	"name": "Simple Dark",
	"include": "./dark_modern.json",
	"type": "dark",
	"colors": {
		"editor.background": "#171616"
	},
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"type": "#4ec98a",
		"class": "#4ec98a",
		"struct": "#4ec98a",
		"enum": "#4ec98a",
		"constant": "#ffc049",
		"boolean": "#ffc049",
		"static": "#ffc049",
		"const": "#ffc049",
		"number": "#ffc049",
		"enumMember": "#ffc049",
		"string": "#ffb261",
		"keyword": "#547fc5",
		"variable": "#72ceff",
		"parameter": "#72ceff",
		"field": "#72ceff",
		"function": "#ff9191",
		"method": "#ff9191",
		"macro": "#ff9191",
		"decorator": "#ff9191",
		"derive": "#4ec98a",
		"module": "#4ec98a",
		"interface": "#4ec98a",
		"namespace": "#4ec98a",
		"variable.defaultLibrary": "#4ec98a",
	},
	"tokenColors": [
		// All constants
		{
			"scope": [
				"constant.other.placeholder",
				"constant.character",
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"entity",
				// bools
				"constant.language.boolean"
			],
			"settings": {
				"foreground": "#ffc049"
			}
		},
		// structs, classes, enums, interfaces, imports, modules, namespaces
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.interface",
				"entity.name.enum",
				"entity.name.namespace",
				"entity.name.module",
				"variable.other.defaultLibrary",
				"meta.use"
			],
			"settings": {
				"foreground": "#4ec98a"
			}
		},
		// functions, methods, macros, decorators, derives
		{
			"scope": [
				"entity.name.function",
				"entity.name.method",
				"entity.name.macro",
				"entity.name.decorator",
				"meta.derive"
			],
			"settings": {
				"foreground": "#ff9191"
			}
		},
		// keywords
		{
			"scope": [
				"keyword",
				"keyword.control"
			],
			"settings": {
				"foreground": "#547fc5"
			}
		},
		// Variables, parameters, fields
		{
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other.readwrite",
				"variable.other.member"
			],
			"settings": {
				"foreground": "#72ceff"
			}
		},
	]
}